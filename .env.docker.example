# ===========================================
# Aether Production Environment Variables
# ===========================================
# Copy this file to .env.docker and fill in all required values
# BEFORE running docker-compose up --build
# ===========================================

# -------------------------------------------
# DOMAIN & URL CONFIGURATION
# -------------------------------------------
AETHER_DOMAIN=aether.iniloka.id
ACME_EMAIL=admin@aether.iniloka.id

# -------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------
POSTGRES_USER=aether
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=aether

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------
# Generate secure secret (run: openssl rand -base64 48)
AUTH_SECRET=<GENERATE_SECURE_SECRET>

# Google OAuth Credentials
# Register at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=<YOUR_GOOGLE_CLIENT_ID>
AUTH_GOOGLE_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# OAuth redirect URI must be: https://${AETHER_DOMAIN}/api/auth/callback/google

# -------------------------------------------
# ENCRYPTION
# -------------------------------------------
# Generate key (run: openssl rand -hex 32)
ENCRYPTION_KEY=<GENERATE_64_CHAR_HEX_KEY>

# -------------------------------------------
# WORKER & CRON SECURITY
# -------------------------------------------
# Generate secrets (run: openssl rand -hex 24 for each)
WORKER_SECRET=<GENERATE_WORKER_SECRET>
CRON_SECRET=<GENERATE_CRON_SECRET>

# -------------------------------------------
# SECURITY SETTINGS
# -------------------------------------------
SIMULATOR_MODE=false
ALLOW_SECURITY_STUBS=false

# -------------------------------------------
# AI PROVIDER CONFIGURATION
# -------------------------------------------
AI_GATEWAY_ENABLED=false
AI_GATEWAY_BASE_URL=https://api.ninerouter.ai/v1
AI_GATEWAY_API_KEY=<YOUR_NINE_ROUTER_API_KEY>
AI_MODEL_PRIMARY=xai/grok-4.5

# -------------------------------------------
# SOCIAL MEDIA PLATFORMS
# -------------------------------------------
# Webhook configuration (external bridge URL required for live mode)
SOCIAL_PUBLISH_WEBHOOK_URL=https://your-bridge-server.com/api/webhook/publish
SOCIAL_PUBLISH_WEBHOOK_TOKEN=<GENERATE_WEHBOOK_TOKEN>
SOCIAL_CONNECTOR_POLICY=official_only

# Instagram OAuth
INSTAGRAM_APP_ID=<YOUR_INSTAGRAM_APP_ID>
INSTAGRAM_APP_SECRET=<YOUR_INSTAGRAM_APP_SECRET>
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# Threads OAuth
THREADS_APP_ID=<YOUR_THREADS_APP_ID>
THREADS_APP_SECRET=<YOUR_THREADS_APP_SECRET>

# TikTok OAuth (if needed)
TIKTOK_CLIENT_KEY=<YOUR_TIKTOK_CLIENT_KEY>
TIKTOK_CLIENT_SECRET=<YOUR_TIKTOK_CLIENT_SECRET>

# -------------------------------------------
# PAYMENT PROCESSING (MIDTRANS)
# -------------------------------------------
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=G838284597
MIDTRANS_SERVER_KEY=<YOUR_SERVER_KEY>
MIDTRANS_CLIENT_KEY=<YOUR_CLIENT_KEY>
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# -------------------------------------------
# REGION CONFIGURATION
# -------------------------------------------
AETHER_REGION=ap-southeast-1

# -------------------------------------------
# NEXT.js CONFIGURATION
# -------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# -------------------------------------------
# PRODUCTION-GATE VALIDATION
# -------------------------------------------
# These are automatically checked during deployment
# Ensure they are set correctly or deployment will fail
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public
APP_URL=https://${AETHER_DOMAIN}
AUTH_URL=https://${AETHER_DOMAIN}

# -------------------------------------------
# NOTES
# -------------------------------------------
# Security Guidelines:
# 1. NEVER commit .env.docker to version control
# 2. Use strong passwords (min 16 chars, mix of upper/lower/number/special)
# 3. Rotate secrets every 90 days
# 4. Monitor unauthorized access attempts
#
# Testing Checklist Before Production:
# - [ ] SIMULATOR_MODE=false confirmed
# - [ ] All OAuth credentials tested in staging
# - [ ] Midtrans keys verified (sandbox first!)
# - [ ] Worker secrets working
# - [ ] Database migrations applied
# - [ ] Superadmin created
# - [ ] Email notifications working
# - [ ] SSL certificates valid
#
# Quick Start Commands:
#   # Generate random secrets
#   openssl rand -base64 48 | tr -d '\n' | pbcopy    # AUTH_SECRET
#   openssl rand -hex 32 | tr -d '\n' | pbcopy       # ENCRYPTION_KEY
#   openssl rand -hex 24 | tr -d '\n' | pbcopy       # WORKER_SECRET
#   openssl rand -hex 24 | tr -d '\n' | pbcopy       # CRON_SECRET
#
#   # Deploy
#   docker compose --env-file .env.docker up -d --build
