# ===========================================
# Komenin Production Environment (Docker/VPS)
# ===========================================
# Salin ke .env.docker lalu isi SEMUA nilai <...> :
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Template ini mirror .env.production.example, ditambah knob khusus Docker
# (KOMENIN_DOMAIN, ACME_EMAIL, POSTGRES_*). Nilai yang diteruskan ke container
# app lihat di docker-compose.yml → service `app` → `environment:`.
# JANGAN commit .env.docker (sudah di .gitignore).
# ===========================================

# -------------------------------------------
# DOMAIN & HTTPS (Traefik + Let's Encrypt)
# -------------------------------------------
KOMENIN_DOMAIN=komenin.id
ACME_EMAIL=admin@komenin.id

# -------------------------------------------
# DATABASE (Postgres internal di compose)
# -------------------------------------------
POSTGRES_USER=komenin
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=komenin
# Self-hosted @db tanpa PgBouncer → DIRECT boleh identik dengan DATABASE_URL.
# Kosongkan = compose memakai DATABASE_URL yang sama (default di bawah).
# Di Neon/Vercel keduanya WAJIB beda (pooler vs direct non-pooler).
# DIRECT_DATABASE_URL=

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------
# openssl rand -base64 48
AUTH_SECRET=<GENERATE_SECURE_SECRET>

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI yang didaftarkan:
#   https://<KOMENIN_DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=<YOUR_GOOGLE_CLIENT_ID>
AUTH_GOOGLE_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# -------------------------------------------
# ENCRYPTION (secret di DB: session/proxy/OAuth vault)
# -------------------------------------------
# openssl rand -hex 32  → 64 hex char. Rotasi butuh re-encrypt
# (scripts/rotate-encryption-key.mjs), jangan asal ganti di DB berisi.
ENCRYPTION_KEY=<GENERATE_64_CHAR_HEX_KEY>

# -------------------------------------------
# WORKER & CRON
# -------------------------------------------
# openssl rand -hex 24 untuk masing-masing
WORKER_SECRET=<GENERATE_WORKER_SECRET>
CRON_SECRET=<GENERATE_CRON_SECRET>

# -------------------------------------------
# HMAC SECRETS (wajib prod — tanpa fallback AUTH_SECRET)
# -------------------------------------------
# openssl rand -hex 32 untuk masing-masing
OAUTH_STATE_SECRET=<GENERATE_OAUTH_STATE_SECRET>
SSO_TICKET_SECRET=<GENERATE_SSO_TICKET_SECRET>
API_KEY_PEPPER=<GENERATE_API_KEY_PEPPER>

# -------------------------------------------
# SECURITY SWITCHES (jangan diubah)
# -------------------------------------------
SIMULATOR_MODE=false
# ALLOW_SECURITY_STUBS / SSO_ENFORCE_LOGIN / SAML_ALLOW_UNSIGNED:
# di-hardcode "false" di docker-compose.yml — tidak perlu diset di sini.

# -------------------------------------------
# DURABLE RATE LIMITING (wajib prod — Upstash)
# -------------------------------------------
UPSTASH_REDIS_REST_URL=https://<upstash-host>
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# -------------------------------------------
# EMAIL TRANSASKIONAL — Brevo (wajib prod)
# -------------------------------------------
# OTP login + digest/threshold gagal diam-diam tanpa ini.
BREVO_API_KEY=xkeysib-<brevo-key>
EMAIL_FROM=Komenin <noreply@komenin.id>
SUPPORT_INBOX_EMAIL=cs@komenin.id

# -------------------------------------------
# AI GATEWAY
# -------------------------------------------
AI_GATEWAY_ENABLED=false
AI_GATEWAY_BASE_URL=https://<gateway-host>/v1
AI_GATEWAY_API_KEY=<YOUR_GATEWAY_API_KEY>
AI_MODEL_PRIMARY=xai/grok-4.5
AI_MODEL_FALLBACKS=
AI_RATE_LIMIT_PER_MIN=60
# Katalog model per tier (opsional — ada default). Lihat .env.example.
# KOMENIN_AI_MODELS_STARTER=
# KOMENIN_AI_MODELS_PRO=
# KOMENIN_AI_MODELS_PRO_MAX=
# Biaya upstream per kredit per model (JSON) — wajib agar margin /admin/ai akurat.
# AI_MODEL_COST_IDR={"gpt-4o-mini":0.003}

# -------------------------------------------
# SOCIAL BRIDGE (live — SIMULATOR_MODE=false)
# -------------------------------------------
# WAJIB host eksternal (bridge/worker terpisah), BUKAN URL app sendiri.
# Production-gate fail-closed kalau ini menunjuk /api/publish/webhook milik app.
SOCIAL_PUBLISH_WEBHOOK_URL=https://your-bridge-server.com/bridge
SOCIAL_PUBLISH_WEBHOOK_TOKEN=<GENERATE_WEBHOOK_TOKEN_MIN_16_CHARS>
SOCIAL_CONNECTOR_POLICY=prefer_webhook
# prefer_webhook | prefer_official | official_only | webhook_only

# OAuth konektor resmi (isi sesuai platform yang live)
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# -------------------------------------------
# MIDTRANS
# -------------------------------------------
# Sandbox dulu, lalu "true" + key live (Mid-server-... / Mid-client-...)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=G838284597
MIDTRANS_SERVER_KEY=<YOUR_SERVER_KEY>
MIDTRANS_CLIENT_KEY=<YOUR_CLIENT_KEY>
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION otomatis mirror MIDTRANS_IS_PRODUCTION
# dari compose — tidak perlu diset manual.

# -------------------------------------------
# ERROR TRACKING (disarankan)
# -------------------------------------------
# SENTRY_DSN=https://<publicKey>@<host>/<projectId>
# SENTRY_ENVIRONMENT=production

# -------------------------------------------
# BACKUP
# -------------------------------------------
# openssl rand -hex 32. Tanpa ini dump backup = plaintext semua secret.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_PLAINTEXT_OK=true  # hanya jika sadar menerima backup plaintext
# BACKUP_RETENTION_DAYS=14

# -------------------------------------------
# REGION
# -------------------------------------------
KOMENIN_REGION=ap-southeast-1

# -------------------------------------------
# CATATAN
# -------------------------------------------
# 1. JANGAN commit .env.docker ke git.
# 2. Rotasi secret tiap 90 hari (ENCRYPTION_KEY butuh re-encrypt dulu).
# 3. Checklist sebelum live: SIMULATOR_MODE=false, migrasi applied,
#    superadmin dibuat, checkout Midtrans sandbox→live, OTP email masuk,
#    service `cron` + `backup` berjalan. Lihat docs/PRODUCTION-CHECKLIST.md.
#
# Generate cepat:
#   openssl rand -base64 48   # AUTH_SECRET
#   openssl rand -hex 32      # ENCRYPTION_KEY / OAUTH_STATE_SECRET /
#                             # SSO_TICKET_SECRET / API_KEY_PEPPER /
#                             # BACKUP_ENCRYPTION_KEY
#   openssl rand -hex 24      # WORKER_SECRET / CRON_SECRET / WEBHOOK_TOKEN
