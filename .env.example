DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="your-auth-secret-min-32-chars-long"
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
APP_URL="http://localhost:3000"
# 64 hex chars (32 bytes). Rotating this key invalidates all encrypted session/proxy secrets
# unless you re-encrypt existing blobs with the previous key first.
ENCRYPTION_KEY="your-64-hex-char-encryption-key-here-0123456789abcdef0123456789abcdef01234567"
# Must be "false" in production. smoke:security / production-gate fail closed if true in NODE_ENV=production.
SIMULATOR_MODE="true"
# Only for local insecure stubs (open publish webhook without token, SAML ACS stub, etc). Never in production.
ALLOW_SECURITY_STUBS="false"
WORKER_SECRET="your-long-random-worker-secret-min-16-chars"
# Vercel Cron auth for the scheduled worker (GET /api/worker/cron, Authorization: Bearer $CRON_SECRET).
# Set this in the Vercel project so the */5m cron in vercel.json can run the worker.tick fan-out.
CRON_SECRET="your-long-random-cron-secret-min-16-chars"
# Hybrid AI gateway bootstrap (OpenAI-compatible, e.g. 9Router)
# Workspace UI can also store OpenAI / Anthropic / custom providers (encrypted).
# Resolution: agent override → workspace providers/defaults → these env values → local fallback.
AI_GATEWAY_ENABLED="true"
AI_GATEWAY_BASE_URL="http://localhost:20128/v1"
AI_GATEWAY_API_KEY=""
AI_MODEL_PRIMARY="xai/grok-4.5"
AI_MODEL_FALLBACKS=""
# Optional multi-provider JSON (advanced). Prefer workspace Settings → AI in the app.
# AI_PROVIDERS='[{"id":"openai","kind":"openai","apiKey":"sk-...","models":["gpt-4o-mini"]}]'
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Local loopback to this app only logs deliveries — it does NOT post to social networks.
# For SIMULATOR_MODE=false production, point this at an EXTERNAL bridge (different host).
# Production-gate / live-readiness fail if this is APP_URL + /api/publish/webhook.
SOCIAL_PUBLISH_WEBHOOK_URL="http://localhost:3000/api/publish/webhook"
# Required when SIMULATOR_MODE=false.
SOCIAL_PUBLISH_WEBHOOK_TOKEN="replace-with-long-random-token"
SOCIAL_CONNECTOR_POLICY="prefer_webhook"
SOCIAL_OFFICIAL_API_BASE_URL=""
SOCIAL_OFFICIAL_API_TOKEN=""
INSTAGRAM_API_BASE_URL=""
THREADS_API_BASE_URL=""
TIKTOK_API_BASE_URL=""
INSTAGRAM_ACCESS_TOKEN=""
THREADS_ACCESS_TOKEN=""
TIKTOK_ACCESS_TOKEN=""

# Midtrans Snap
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""

# Official native connectors / OAuth
INSTAGRAM_GRAPH_BASE_URL="https://graph.facebook.com/v21.0"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Optional override; defaults to APP_URL + /api/connectors/instagram/callback
# INSTAGRAM_OAUTH_SCOPES="instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement"
# Optional dedicated secret for signed OAuth state (falls back to AUTH_SECRET)
# OAUTH_STATE_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
# THREADS_OAUTH_SCOPES="threads_basic,threads_content_publish"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# TIKTOK_OAUTH_SCOPES="user.info.basic,video.publish,video.upload"

# SSO (SAML XML signature validation is NOT production-ready)
# SSO_ENFORCE_LOGIN="false"
# ALLOW_SECURITY_STUBS="true"  # local only: unsigned SAML/dev ACS + ticket→session bridge
# SAML_ALLOW_UNSIGNED="true"   # local only; ignored in NODE_ENV=production
# SSO_TICKET_SECRET=""         # optional; falls back to AUTH_SECRET

# Region
AETHER_REGION="ap-southeast-1"
