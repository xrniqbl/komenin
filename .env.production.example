# Komenin — PRODUCTION environment template (fail-safe values).
# Copy to your platform (Vercel env / docker .env) and fill every empty value.
# Do NOT copy .env.example to production: its defaults are dev-only
# (SIMULATOR_MODE=true, localhost webhook, http gateway) and the production
# gate + preflight will refuse to boot with them.
#
# After filling, verify with:
#   npm run preflight -- --strict && npm run smoke:security

# --- Core runtime ---
DATABASE_URL="postgresql://user:password@<pooler-host>:5432/dbname?sslmode=require&connection_limit=5&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://user:password@<direct-host>:5432/dbname?sslmode=require"
AUTH_SECRET="<openssl rand -base64 32>"
APP_URL="https://komenin.id"
AUTH_URL="https://komenin.id"
# AUTH_TRUST_HOST must stay unset/false in production (Auth.js must not trust Host header).
AUTH_TRUST_HOST="false"
ENCRYPTION_KEY="<openssl rand -hex 32>"
SIMULATOR_MODE="false"
ALLOW_SECURITY_STUBS="false"
WORKER_SECRET="<openssl rand -hex 32>"
CRON_SECRET="<openssl rand -hex 32>"

# --- SSO/SAML kill-switches (signature validation unimplemented — keep off) ---
SSO_ENFORCE_LOGIN="false"
SAML_ALLOW_UNSIGNED="false"

# --- Secrets for OAuth state / SSO tickets / API keys (no AUTH_SECRET fallback in prod) ---
OAUTH_STATE_SECRET="<openssl rand -hex 32>"
SSO_TICKET_SECRET="<openssl rand -hex 32>"
API_KEY_PEPPER="<openssl rand -hex 32>"

# --- Social bridge (EXTERNAL host — never this app's own /api/publish/webhook) ---
SOCIAL_CONNECTOR_POLICY="prefer_webhook"
SOCIAL_PUBLISH_WEBHOOK_URL="https://bridge.<yourdomain>/bridge"
SOCIAL_PUBLISH_WEBHOOK_TOKEN="<long random token, min 16 chars>"

# --- AI gateway (https only — keys leak over plaintext http) ---
AI_GATEWAY_ENABLED="true"
AI_GATEWAY_BASE_URL="https://<gateway-host>/v1"
AI_GATEWAY_API_KEY="<gateway key>"
AI_MODEL_PRIMARY="xai/grok-4.5"
AI_MODEL_FALLBACKS=""
AI_RATE_LIMIT_PER_MIN="60"

# --- Billing / Midtrans (live) ---
MIDTRANS_IS_PRODUCTION="true"
MIDTRANS_SERVER_KEY="Mid-server-<live>"
MIDTRANS_CLIENT_KEY="Mid-client-<live>"
MIDTRANS_MERCHANT_ID="<merchant id>"

# --- Durable rate limiting (required — memory fallback is weak on serverless) ---
UPSTASH_REDIS_REST_URL="https://<upstash-host>"
UPSTASH_REDIS_REST_TOKEN="<upstash token>"

# --- Email (required — OTP login + digests silently fail without it) ---
BREVO_API_KEY="xkeysib-<brevo key>"
EMAIL_FROM="Komenin <noreply@komenin.id>"
SUPPORT_INBOX_EMAIL="cs@komenin.id"

# --- Error tracking (recommended — without it prod is local logs only) ---
SENTRY_DSN="https://<publicKey>@<host>/<projectId>"
SENTRY_ENVIRONMENT="production"

# --- Region / backups ---
KOMENIN_REGION="ap-southeast-1"
BACKUP_ENCRYPTION_KEY="<openssl rand -hex 32>"

# --- Search Console ownership (site-verification meta, omitted when empty) ---
# Fill after claiming the domain in Google Search Console / Bing Webmaster.
# Without these the <meta> tags are simply not rendered — safe to leave empty.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# --- Sitemap freshness (stable lastModified instead of "every build") ---
# BUILD_DATE pins <lastmod> for sitemap entries. Bump (YYYY-MM-DD) only when
# public content actually changes so crawlers don't re-crawl on every deploy.
BUILD_DATE="2026-10-03"
