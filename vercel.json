{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/worker/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/worker/cron?job=comment.send",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/worker/cron?job=mention.process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/worker/cron?job=content.publish",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/worker/cron?job=connector.refresh_tokens",
      "schedule": "41 * * * *"
    },
    {
      "path": "/api/worker/cron?job=digest.approvals",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/worker/cron?job=ai.quota_notify",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/worker/cron?job=ai.expire",
      "schedule": "23 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
