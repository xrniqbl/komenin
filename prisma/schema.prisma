  @@index([workspaceId, status, createdAt(sort: Desc)])
}

enum CommentSource {
  target_post
  mention_reply
}

model CommentAction {
  id                String        @id @default(cuid())
  workspaceId       String
  campaignId        String?
  targetPostId      String
  commentDraftId    String?       @unique
  socialAccountId   String?
  status            String
  resultMessage     String?
  scheduledFor      DateTime?
  executedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  /// Set when this action is a reply to an incoming comment/mention rather
  /// than a comment on a discovered target post.
  source            CommentSource @default(target_post)
  replyToExternalId String?
  replyToAuthor     String?
  mentionId         String?       @unique
  attemptCount      Int           @default(0)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetPost    TargetPost     @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  commentDraft  CommentDraft?  @relation(fields: [commentDraftId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  mention       Mention?       @relation(fields: [mentionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status, scheduledFor])
}

enum MentionStatus {
  new
  generating
  drafted
  approved
  sent
  ignored
  failed
}

/// Incoming comment/mention/reply on the workspace's own social accounts,
/// ingested via platform webhooks or polling (discovery), then fed into the
/// auto-reply pipeline.
model Mention {
  id               String        @id @default(cuid())
  workspaceId      String
  platform         Platform
  socialAccountId  String?
  externalId       String
  /// externalId of the parent post/comment being replied to
  parentExternalId String
  parentContent    String        @db.Text
  authorHandle     String
  content          String        @db.Text
  url              String?
  status           MentionStatus @default(new)
  /// Operator owner (User.id) for daily triage; nullable + SetNull on delete.
  assigneeId       String?
  /// Raw webhook/ingest payload for debugging (delivery webhook style)
  rawPayload       Json?
  receivedAt       DateTime      @default(now())
  processedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("MentionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// All reply drafts for this mention (newest first in queries). Kept as a
  /// list so operators can compare variants; approval still picks one.
  drafts        CommentDraft[] @relation("MentionDrafts")
  action        CommentAction?

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, status, receivedAt(sort: Desc)])
  @@index([socialAccountId, receivedAt(sort: Desc)])
  @@index([assigneeId])
}

/// Per-workspace auto-reply configuration for incoming mentions.
model AutoReplySettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  enabled          Boolean  @default(false)
  agentId          String?
  mode             String   @default("approval_required")
  maxRepliesPerDay Int      @default(20)
  quietHoursApply  Boolean  @default(true)
  /// Optional reply template ("Balas {{authorHandle}} pakai {{template}}").
  /// When set it overrides AI generation; variables render via renderTemplate.
  templateText     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

