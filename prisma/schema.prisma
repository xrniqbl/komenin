generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  operator
  analyst
  auditor
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum WorkspaceStatus {
  active
  suspended
  deleted
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  googleSub     String?      @unique
  platformRole  PlatformRole @default(user)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  sentInvites Invite[]  @relation("InviteSender")
  auditLogs   AuditLog[]
  voucherRedemptions VoucherRedemption[]
  subscriptionOrders SubscriptionOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  timezone  String          @default("Asia/Jakarta")
  status    WorkspaceStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  memberships    Membership[]
  invites        Invite[]
  auditLogs      AuditLog[]
  socialAccounts SocialAccount[]
  proxyEndpoints ProxyEndpoint[]
  accountSessions AccountSession[]
  ipRotationLogs IpRotationLog[]
  sessionHealthChecks SessionHealthCheck[]
  campaigns Campaign[]
  listeners Listener[]
  targetPosts TargetPost[]
  commentDrafts CommentDraft[]
  commentActions CommentAction[]
  approvals Approval[]
  agents Agent[]
  contentCampaigns ContentCampaign[]
  contentDrafts ContentDraft[]
  connectorPolicy ConnectorPolicy @default(prefer_webhook)
  planCode String @default("growth")
  monthlySendLimit Int @default(5000)
  monthlyPublishLimit Int @default(1000)
  webhookEndpoints WebhookEndpoint[]
  connectorCredentials ConnectorCredential[]
  deliveryLogs DeliveryLog[]
  jobRuns JobRun[]
  notifications Notification[]
  digestMarkers DigestMarker[]
  usageCounters UsageCounter[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  memoryEntries MemoryEntry[]
  skills Skill[]
  skillRuns SkillRun[]
  agentGuardrails AgentGuardrail[]
  homeRegion      String   @default("ap-southeast-1")
  ssoRequired     Boolean  @default(false)
  billingEmail    String?
  subscriptions   Subscription[]
  subscriptionOrders SubscriptionOrder[]
  voucherRedemptions VoucherRedemption[]
  ssoConfigs        SsoConfig[]
  riskRules         RiskRule[]
  riskScanLogs      RiskScanLog[]
  commentTemplates  CommentTemplate[]
  competitorProfiles CompetitorProfile[]
  apiKeys           ApiKey[]
  customRoles       CustomRole[]
  aiProviders       WorkspaceAiProvider[]
  clientProfiles    ClientProfile[]
  engagementLeads   EngagementLead[]
  // Workspace-level AI defaults (provider keys live on WorkspaceAiProvider)
  aiDefaultProviderId String?
  aiDefaultModel      String?
  aiFallbackModels    String[] @default([])
  aiTemperature       Float    @default(0.5)
  aiMaxTokens         Int      @default(280)
  /** Quiet hours (workspace local time, [start, end)). start == end disables. */
  quietHoursStart     Int      @default(0)
  quietHoursEnd       Int      @default(0)
  /** Optional agency mode label shown in UI (e.g. "Acme Agency"). */
  agencyLabel         String?
}


model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([customRoleId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(operator)
  tokenHash   String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}


enum Platform {
  instagram
  threads
  tiktok
}

enum SocialAccountStatus {
  draft
  connecting
  healthy
  degraded
  limited
  banned
  archived
}

enum ProxyProtocol {
  http
  https
  socks5
}

enum ProxyType {
  residential
  mobile
  datacenter
}

enum RotationMode {
  sticky
  per_action
  timed
}

model SocialAccount {
  id           String              @id @default(cuid())
  workspaceId  String
  platform     Platform
  username     String
  displayName  String?
  externalId   String?
  status       SocialAccountStatus @default(draft)
  healthScore  Int                 @default(100)
  currentIp    String?
  lastActionAt DateTime?
  dailyQuota   Int                 @default(50)
  actionsToday Int                 @default(0)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  AccountSession[]
  proxyAssignments ProxyAssignment[]
  healthChecks SessionHealthCheck[]
  rotationLogs IpRotationLog[]
  campaignAccounts CampaignAccount[]
  commentActions CommentAction[]

  @@unique([workspaceId, platform, username])
  @@index([workspaceId, status])
  contentCampaigns ContentCampaign[]
  contentDrafts ContentDraft[]
  connectorCredentials ConnectorCredential[]
  deliveryLogs DeliveryLog[]
}


model AccountSession {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String
  encryptedBlob   String   @db.Text
  keyVersion      Int      @default(1)
  userAgent       String
  fingerprintJson Json?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, socialAccountId])
  @@index([socialAccountId, isActive])
}

model ProxyEndpoint {
  id           String        @id @default(cuid())
  workspaceId  String
  label        String
  protocol     ProxyProtocol
  host         String
  port         Int
  usernameEnc  String?
  passwordEnc  String?
  provider     String?
  type         ProxyType     @default(residential)
  country      String?
  rotationMode RotationMode  @default(sticky)
  rotateEveryMin Int?
  isHealthy    Boolean       @default(true)
  lastCheckedAt DateTime?
  lastIp       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments ProxyAssignment[]
  rotationLogs IpRotationLog[]

  @@index([workspaceId, isHealthy])
}

model ProxyAssignment {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String
  proxyEndpointId String
  isActive        Boolean  @default(true)
  assignedAt      DateTime @default(now())
  releasedAt      DateTime?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  proxyEndpoint ProxyEndpoint @relation(fields: [proxyEndpointId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, isActive])
  @@index([proxyEndpointId, isActive])
}

model IpRotationLog {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  proxyEndpointId String?
  oldIp           String?
  newIp           String?
  reason          String
  success         Boolean  @default(true)
  createdAt       DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  proxyEndpoint ProxyEndpoint? @relation(fields: [proxyEndpointId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model SessionHealthCheck {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String
  ok              Boolean
  latencyMs       Int?
  signal          String?
  details         String?
  createdAt       DateTime @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([socialAccountId, createdAt(sort: Desc)])
}


enum CampaignMode {
  draft
  approval_required
  auto
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  failed
}

enum ListenerType {
  keyword
  competitor
  trend
}

enum TargetPostStatus {
  new
  generating
  drafted
  approved
  sent
  skipped
  failed
}

enum DraftStatus {
  pending
  approved
  rejected
  sent
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  tone         String   @default("professional")
  language     String   @default("id")
  systemPrompt String   @db.Text
  status       String   @default("active")
  // Optional model routing override (workspace provider + model id)
  aiProviderId String?
  model        String?
  temperature  Float?
  maxTokens    Int?
  // Personality / characteristics pack for comment bots
  style        String   @default("balanced") // concise | balanced | detailed | expert
  formality    String   @default("neutral") // casual | neutral | formal
  emojiPolicy  String   @default("light") // none | light | ok
  ctaStyle     String   @default("soft") // none | soft | direct
  maxSentences Int      @default(3)
  bannedTopics String[] @default([])
  mustInclude  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiProvider WorkspaceAiProvider? @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  campaigns  Campaign[]
  drafts     CommentDraft[]

  @@index([workspaceId, status])
  @@index([aiProviderId])
  contentCampaigns ContentCampaign[]
  contentDrafts ContentDraft[]
  guardrails AgentGuardrail[]
  knowledgeDocuments KnowledgeDocument[]
  memoryEntries MemoryEntry[]
  skillRuns SkillRun[]
  riskRules RiskRule[]
}

enum AiProviderKind {
  ninerouter
  openai
  anthropic
  openai_compatible
}

model WorkspaceAiProvider {
  id         String         @id @default(cuid())
  workspaceId String
  kind       AiProviderKind
  label      String
  baseUrl    String?
  apiKeyEnc  String?        @db.Text
  models     String[]
  isEnabled  Boolean        @default(true)
  priority   Int            @default(100)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@index([workspaceId, isEnabled, priority])
}


model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String
  platform      Platform
  mode          CampaignMode   @default(approval_required)
  status        CampaignStatus @default(draft)
  agentId       String?
  clientId      String?
  dailyLimit    Int            @default(30)
  minDelaySec   Int            @default(45)
  maxDelaySec   Int            @default(180)
  goal          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  client    ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accounts  CampaignAccount[]
  listeners Listener[]
  targetPosts TargetPost[]
  drafts    CommentDraft[]
  actions   CommentAction[]
  approvals Approval[]
  leads     EngagementLead[]

  @@index([workspaceId, status])
  @@index([clientId])
}

model CampaignAccount {
  id              String @id @default(cuid())
  campaignId      String
  socialAccountId String

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, socialAccountId])
}

model Listener {
  id          String       @id @default(cuid())
  workspaceId String
  campaignId  String?
  platform    Platform
  type        ListenerType
  query       String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  posts     TargetPost[]

  @@index([workspaceId, isActive])
}

model TargetPost {
  id           String           @id @default(cuid())
  workspaceId  String
  campaignId   String?
  listenerId   String?
  platform     Platform
  externalId   String
  authorHandle String
  content      String           @db.Text
  url          String?
  status       TargetPostStatus @default(new)
  discoveredAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  listener  Listener? @relation(fields: [listenerId], references: [id], onDelete: SetNull)
  drafts    CommentDraft[]
  actions   CommentAction[]
  approvals Approval[]
  leads     EngagementLead[]

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, status, discoveredAt(sort: Desc)])
}

model CommentDraft {
  id           String      @id @default(cuid())
  workspaceId  String
  campaignId   String?
  targetPostId String
  agentId      String?
  content      String      @db.Text
  status       DraftStatus @default(pending)
  providerId   String?
  model        String?
  riskFlags    String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetPost TargetPost @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  agent      Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  approval   Approval?
  action     CommentAction?

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model Approval {
  id             String         @id @default(cuid())
  workspaceId    String
  campaignId     String?
  targetPostId   String
  commentDraftId String         @unique
  status         ApprovalStatus @default(pending)
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetPost   TargetPost   @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  commentDraft CommentDraft @relation(fields: [commentDraftId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model CommentAction {
  id              String   @id @default(cuid())
  workspaceId     String
  campaignId      String?
  targetPostId    String
  commentDraftId  String?  @unique
  socialAccountId String?
  status          String
  resultMessage   String?
  scheduledFor    DateTime?
  executedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetPost    TargetPost     @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  commentDraft  CommentDraft?  @relation(fields: [commentDraftId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

enum ContentIntervalUnit {
  minutes
  hours
  days
}

enum ContentCampaignStatus {
  draft
  generating
  active
  paused
  completed
  failed
}

enum ContentDraftStatus {
  pending
  approved
  rejected
  scheduled
  publishing
  published
  failed
}

model ContentCampaign {
  id              String                @id @default(cuid())
  workspaceId     String
  name            String
  topic           String                @db.Text
  platform        Platform
  mode            CampaignMode          @default(approval_required)
  status          ContentCampaignStatus @default(draft)
  agentId         String?
  socialAccountId String?
  postCount       Int
  intervalValue   Int
  intervalUnit    ContentIntervalUnit   @default(hours)
  startAt         DateTime              @default(now())
  generatedCount  Int                   @default(0)
  publishedCount  Int                   @default(0)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  drafts        ContentDraft[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model ContentDraft {
  id                String             @id @default(cuid())
  workspaceId       String
  contentCampaignId String
  agentId           String?
  socialAccountId   String?
  sequence          Int
  title             String?
  body              String             @db.Text
  hashtags          String[]
  /** Public image URL for native Instagram/Threads image posts. */
  mediaUrl          String?
  status            ContentDraftStatus @default(pending)
  scheduledFor      DateTime?
  publishedAt       DateTime?
  resultMessage     String?
  providerId        String?
  model             String?
  riskFlags         String[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentCampaign ContentCampaign @relation(fields: [contentCampaignId], references: [id], onDelete: Cascade)
  agent           Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  socialAccount   SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([contentCampaignId, sequence])
  @@index([workspaceId, status, scheduledFor])
  @@index([status, scheduledFor])
}

enum ConnectorPolicy {
  prefer_official
  prefer_webhook
  webhook_only
  official_only
  simulator_only
}

enum DeliveryKind {
  publish_post
  publish_webhook
  send_comment
  discover_posts
  health_probe
  rotate_proxy
  send_comment_preflight
}

enum LeadStatus {
  new
  contacted
  qualified
  won
  lost
  archived
}

enum LeadSource {
  inbox
  approval
  comment
  manual
  api
}

enum JobRunStatus {
  queued
  running
  succeeded
  failed
}

enum NotificationStatus {
  unread
  read
  archived
}

enum KnowledgeStatus {
  pending
  processing
  ready
  failed
}

enum SkillExecutor {
  builtin
  webhook
}

enum SkillRunStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  url          String
  secretEnc    String?  @db.Text
  actions      String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model ConnectorCredential {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  provider        String
  label           String?
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String?  @db.Text
  apiBaseUrl      String?
  scopes          String[]
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, provider, isActive])
}

model DeliveryLog {
  id              String       @id @default(cuid())
  workspaceId     String?
  socialAccountId String?
  kind            DeliveryKind
  connector       String
  mode            String
  ok              Boolean
  externalId      String?
  message         String?
  payload         Json?
  createdAt       DateTime     @default(now())

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, kind, createdAt(sort: Desc)])
}

model JobRun {
  id          String       @id @default(cuid())
  workspaceId String?
  job         String
  status      JobRunStatus @default(queued)
  message     String?
  count       Int?
  details     Json?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([job, startedAt(sort: Desc)])
}

model Notification {
  id          String             @id @default(cuid())
  workspaceId String
  title       String
  body        String
  href        String?
  status      NotificationStatus @default(unread)
  createdAt   DateTime           @default(now())
  readAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// Once-per-day sent marker for digest emails (approval digest etc.).
model DigestMarker {
  id          String   @id @default(cuid())
  workspaceId String
  /// UTC day key: YYYY-MM-DD
  dayKey      String
  kind        String   @default("approval_digest")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dayKey])
  @@index([workspaceId, dayKey])
}

model UsageCounter {
  id          String   @id @default(cuid())
  workspaceId String
  periodKey   String
  sends       Int      @default(0)
  publishes   Int      @default(0)
  generates   Int      @default(0)
  skillRuns   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodKey])
  @@index([workspaceId, periodKey])
}

model AgentGuardrail {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String
  key         String
  value       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([workspaceId, agentId])
}

model KnowledgeDocument {
  id          String          @id @default(cuid())
  workspaceId String
  agentId     String?
  title       String
  sourceType  String          @default("text")
  sourceUrl   String?
  rawText     String          @db.Text
  status      KnowledgeStatus @default(pending)
  error       String?
  chunkCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([agentId])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  ordinal     Int
  content     String   @db.Text
  tokenCount  Int      @default(0)
  embedding   Json?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([workspaceId, documentId])
}

model MemoryEntry {
  id           String   @id @default(cuid())
  workspaceId  String
  agentId      String?
  entityType   String
  entityKey    String
  fact         String   @db.Text
  confidence   Float    @default(0.7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entityType, entityKey])
  @@index([agentId])
}

model Skill {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  executor    SkillExecutor @default(builtin)
  configJson  Json?
  highRisk    Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggers  SkillTrigger[]
  runs      SkillRun[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

model SkillTrigger {
  id        String   @id @default(cuid())
  skillId   String
  pattern   String
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model SkillRun {
  id          String         @id @default(cuid())
  workspaceId String
  skillId     String
  agentId     String?
  status      SkillRunStatus @default(pending)
  inputJson   Json?
  outputJson  Json?
  error       String?
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  agent     Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  steps     SkillRunStep[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([skillId, createdAt(sort: Desc)])
}

model SkillRunStep {
  id        String   @id @default(cuid())
  runId     String
  ordinal   Int
  title     String
  detail    String?  @db.Text
  status    String   @default("ok")
  createdAt DateTime @default(now())

  run SkillRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@index([runId])
}


enum PlatformRole {
  user
  superadmin
}

enum PlanInterval {
  month
  months_6
  months_12
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum OrderStatus {
  pending
  paid
  failed
  canceled
  expired
  refunded
}

enum VoucherType {
  percent
  fixed
}

enum SsoProtocol {
  saml
  oidc
}

model Region {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id                  String       @id @default(cuid())
  code                String       @unique
  name                String
  description         String?
  interval            PlanInterval
  durationMonths      Int
  priceIdr            Int
  monthlySendLimit    Int          @default(5000)
  monthlyPublishLimit Int          @default(1000)
  isActive            Boolean      @default(true)
  sortOrder           Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  subscriptions Subscription[]
  orders        SubscriptionOrder[]
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String
  planId                 String
  status                 SubscriptionStatus @default(active)
  startsAt               DateTime           @default(now())
  endsAt                 DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  midtransSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  orders    SubscriptionOrder[]

  @@index([workspaceId, status])
  @@index([endsAt])
}

model SubscriptionOrder {
  id              String      @id @default(cuid())
  workspaceId     String
  planId          String
  userId          String?
  subscriptionId  String?
  voucherId       String?
  orderCode       String      @unique
  status          OrderStatus @default(pending)
  currency        String      @default("IDR")
  subtotalIdr     Int
  discountIdr     Int         @default(0)
  totalIdr        Int
  snapToken       String?
  snapRedirectUrl String?
  midtransOrderId String?     @unique
  midtransTxnId   String?
  paymentType     String?
  paidAt          DateTime?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  voucher           Voucher?           @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  paymentEvents     PaymentEvent[]
  voucherRedemption VoucherRedemption?

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model PaymentEvent {
  id                String   @id @default(cuid())
  orderId           String
  provider          String   @default("midtrans")
  eventType         String
  transactionStatus String?
  payload           Json
  signatureValid    Boolean  @default(false)
  createdAt         DateTime @default(now())

  order SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
}

model Voucher {
  id                String      @id @default(cuid())
  code              String      @unique
  type              VoucherType
  value             Int
  maxRedemptions    Int?
  redeemedCount     Int         @default(0)
  perWorkspaceLimit Int         @default(1)
  minSubtotalIdr    Int?
  allowedPlanCodes  String[]
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  redemptions VoucherRedemption[]
  orders      SubscriptionOrder[]

  @@index([isActive, expiresAt])
}

model VoucherRedemption {
  id          String   @id @default(cuid())
  voucherId   String
  workspaceId String
  userId      String?
  orderId     String   @unique
  discountIdr Int
  createdAt   DateTime @default(now())

  voucher   Voucher           @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([workspaceId])
}

model SsoConfig {
  id          String        @id @default(cuid())
  workspaceId String
  protocol    SsoProtocol   @default(saml)
  issuer      String
  entryPoint  String
  certificate String        @db.Text
  emailDomain String?
  defaultRole WorkspaceRole @default(operator)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@index([emailDomain])
}

model RiskRule {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  type        String   @default("banned_phrase")
  pattern     String   @db.Text
  severity    String   @default("medium")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isActive])
  @@index([agentId])
}

model RiskScanLog {
  id          String   @id @default(cuid())
  workspaceId String
  targetType  String
  targetId    String
  flags       String[]
  score       Float?
  details     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model CommentTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String   @db.Text
  category    String   @default("general")
  variables   String[]
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category])
  @@unique([workspaceId, name])
}

model CompetitorProfile {
  id            String   @id @default(cuid())
  workspaceId   String
  handle        String
  platform      Platform
  displayName   String?
  isActive      Boolean  @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId, isActive])
}

model ApiKey {
  id         String    @id @default(cuid())
  workspaceId String
  name       String
  prefix     String
  hashedKey  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model CustomRole {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Agency multi-client tag — lightweight isolation label inside one workspace.
model ClientProfile {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     EngagementLead[]
  campaigns Campaign[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

/// Lead captured from social engagement (comment/inbox/approval).
model EngagementLead {
  id            String     @id @default(cuid())
  workspaceId   String
  clientId      String?
  targetPostId  String?
  campaignId    String?
  platform      Platform?
  handle        String
  displayName   String?
  contactEmail  String?
  contactPhone  String?
  source        LeadSource @default(manual)
  status        LeadStatus @default(new)
  intent        String?
  notes         String?    @db.Text
  postSnippet   String?    @db.Text
  draftSnippet  String?    @db.Text
  externalUrl   String?
  /** Optional operator owner (User.id) for follow-up accountability. */
  ownerUserId   String?
  /** Next follow-up due date (workspace-local intent; stored UTC). */
  followUpAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  targetPost TargetPost?    @relation(fields: [targetPostId], references: [id], onDelete: SetNull)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, handle])
  @@index([clientId])
  @@index([workspaceId, followUpAt])
  @@index([ownerUserId])
}

