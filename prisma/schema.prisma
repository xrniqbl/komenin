generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations/introspect use the direct (non-pooler) endpoint: PgBouncer can
  // leave Prisma's migration advisory lock stranded on an idle backend (P1002).
  directUrl = env("DIRECT_DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  operator
  analyst
  auditor
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum WorkspaceStatus {
  active
  suspended
  deleted
}

model User {
  id               String       @id @default(cuid())
  name             String?
  email            String       @unique
  emailVerified    DateTime?
  image            String?
  googleSub        String?      @unique
  platformRole     PlatformRole @default(user)
  lastLoginAt      DateTime?
  // TOTP 2FA — secret is AES-256-GCM encrypted (lib/encryption), null when never enrolled.
  totpSecretEnc    String?
  totpEnabledAt    DateTime?
  // Replay protection: the last successfully verified counter step (30s units).
  // A verify whose step is <= this value is a reused code and is rejected.
  totpLastUsedStep Int?
  // Platform-level suspension — set from /admin/users; blocks new logins and
  // ends existing sessions via the jwt revocation check.
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  sentInvites         Invite[]            @relation("InviteSender")
  auditLogs           AuditLog[]
  assignedMentions    Mention[]           @relation("MentionAssignee")
  assignedTargetPosts TargetPost[]        @relation("TargetPostAssignee")
  voucherRedemptions  VoucherRedemption[]
  subscriptionOrders  SubscriptionOrder[]
  supportTickets      SupportTicket[]
  loginSessions       LoginSession[]
}

/// One row per issued login-token family (JWT jti). Lets the user list and
/// revoke signed-in devices; revocation is enforced in the Node jwt callback.
model LoginSession {
  id             String    @id @default(cuid())
  userId         String
  jti            String    @unique
  provider       String?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  /// Set when the TOTP challenge is passed for this device session. The JWT
  /// `totpGate` flag is cleared only when this row says so — never from a
  /// client-supplied session value (see jwt callback in src/lib/auth.ts).
  totpVerifiedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Durable single-use nonce registry (M5) for SSO tickets + OAuth states.
/// In-memory Maps only work per server process — on multi-instance/serverless
/// deploys a sniffed ticket/state could be replayed against another instance.
/// The UNIQUE nonceHash makes the claim atomic: exactly one concurrent
/// consumer wins, losers get P2002. Pruned opportunistically on insert.
model ConsumedNonce {
  id        String   @id @default(cuid())
  /// "sso_ticket" | "oauth_state" — namespaced so identical nonces cannot collide.
  kind      String
  /// sha256("<kind>:<nonce>") — the raw nonce never touches the database.
  nonceHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One-time passcode for email sign-in. The 6-digit code is stored HASHED
/// (sha256 + per-code salt) so a database read never reveals usable codes.
/// Single-use, short-lived, and attempt-capped to blunt brute force.
model EmailOtpToken {
  id         String    @id @default(cuid())
  /// Lowercased email the code was issued for.
  email      String
  /// sha256(salt + ":" + code) — never the raw code.
  codeHash   String
  salt       String
  expiresAt  DateTime
  /// Failed verification attempts; locked after MAX_ATTEMPTS.
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Workspace {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  timezone  String          @default("Asia/Jakarta")
  status    WorkspaceStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  memberships           Membership[]
  invites               Invite[]
  auditLogs             AuditLog[]
  socialAccounts        SocialAccount[]
  proxyEndpoints        ProxyEndpoint[]
  accountSessions       AccountSession[]
  ipRotationLogs        IpRotationLog[]
  sessionHealthChecks   SessionHealthCheck[]
  campaigns             Campaign[]
  listeners             Listener[]
  targetPosts           TargetPost[]
  commentDrafts         CommentDraft[]
  commentActions        CommentAction[]
  approvals             Approval[]
  agents                Agent[]
  contentCampaigns      ContentCampaign[]
  contentDrafts         ContentDraft[]
  connectorPolicy       ConnectorPolicy          @default(prefer_webhook)
  planCode              String                   @default("growth")
  monthlySendLimit      Int                      @default(5000)
  monthlyPublishLimit   Int                      @default(1000)
  webhookEndpoints      WebhookEndpoint[]
  connectorCredentials  ConnectorCredential[]
  deliveryLogs          DeliveryLog[]
  mentions              Mention[]
  autoReplySettings     AutoReplySettings?
  jobRuns               JobRun[]
  notifications         Notification[]
  digestMarkers         DigestMarker[]
  aiSubscription        WorkspaceAiSubscription?
  aiCreditLedger        AiCreditLedger[]
  aiUsageEvents         AiUsageEvent[]
  aiBalance             WorkspaceAiBalance?
  usageCounters         UsageCounter[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  memoryEntries         MemoryEntry[]
  skills                Skill[]
  skillRuns             SkillRun[]
  agentGuardrails       AgentGuardrail[]
  homeRegion            String                   @default("ap-southeast-1")
  ssoRequired           Boolean                  @default(false)
  billingEmail          String?
  subscriptions         Subscription[]
  subscriptionOrders    SubscriptionOrder[]
  voucherRedemptions    VoucherRedemption[]
  ssoConfigs            SsoConfig[]
  riskRules             RiskRule[]
  riskScanLogs          RiskScanLog[]
  commentTemplates      CommentTemplate[]
  competitorProfiles    CompetitorProfile[]
  apiKeys               ApiKey[]
  customRoles           CustomRole[]
  aiProviders           WorkspaceAiProvider[]
  clientProfiles        ClientProfile[]
  engagementLeads       EngagementLead[]
  supportTickets        SupportTicket[]
  // Workspace-level AI defaults (provider keys live on WorkspaceAiProvider)
  aiDefaultProviderId   String?
  aiDefaultModel        String?
  aiFallbackModels      String[]                 @default([])
  aiTemperature         Float                    @default(0.5)
  aiMaxTokens           Int                      @default(280)
  /// Prefer encrypted workspace providers (BYOK) before Komenin-funded AI.
  aiPreferOwnKey        Boolean                  @default(true)
  /// Pro Max only: when the subscription quota is spent, continue on the PAYG
  /// balance instead of failing closed. Ignored for other tiers.
  aiPaygFallbackEnabled Boolean                  @default(true)
  /**
   * Quiet hours (workspace local time, [start, end)). start == end disables.
   */
  quietHoursStart       Int                      @default(0)
  quietHoursEnd         Int                      @default(0)
  /**
   * Optional agency mode label shown in UI (e.g. "Acme Agency").
   */
  agencyLabel           String?
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([customRoleId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(operator)
  tokenHash   String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
}

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

enum Platform {
  instagram
  threads
  tiktok
}

enum SocialAccountStatus {
  draft
  connecting
  healthy
  degraded
  limited
  banned
  archived
}

enum ProxyProtocol {
  http
  https
  socks5
}

enum ProxyType {
  residential
  mobile
  datacenter
}

enum RotationMode {
  sticky
  per_action
  timed
}

model SocialAccount {
  id           String              @id @default(cuid())
  workspaceId  String
  platform     Platform
  username     String
  displayName  String?
  externalId   String?
  status       SocialAccountStatus @default(draft)
  healthScore  Int                 @default(100)
  currentIp    String?
  lastActionAt DateTime?
  dailyQuota   Int                 @default(50)
  actionsToday Int                 @default(0)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions             AccountSession[]
  proxyAssignments     ProxyAssignment[]
  healthChecks         SessionHealthCheck[]
  rotationLogs         IpRotationLog[]
  campaignAccounts     CampaignAccount[]
  commentActions       CommentAction[]
  contentCampaigns     ContentCampaign[]
  contentDrafts        ContentDraft[]
  connectorCredentials ConnectorCredential[]
  deliveryLogs         DeliveryLog[]
  mentions             Mention[]

  @@unique([workspaceId, platform, username])
  @@index([workspaceId, status])
}

model AccountSession {
  id              String    @id @default(cuid())
  workspaceId     String
  socialAccountId String
  encryptedBlob   String    @db.Text
  keyVersion      Int       @default(1)
  userAgent       String
  fingerprintJson Json?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, socialAccountId])
  @@index([socialAccountId, isActive])
}

model ProxyEndpoint {
  id             String        @id @default(cuid())
  workspaceId    String
  label          String
  protocol       ProxyProtocol
  host           String
  port           Int
  usernameEnc    String?
  passwordEnc    String?
  provider       String?
  type           ProxyType     @default(residential)
  country        String?
  rotationMode   RotationMode  @default(sticky)
  rotateEveryMin Int?
  isHealthy      Boolean       @default(true)
  lastCheckedAt  DateTime?
  lastIp         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments  ProxyAssignment[]
  rotationLogs IpRotationLog[]

  @@index([workspaceId, isHealthy])
}

model ProxyAssignment {
  id              String    @id @default(cuid())
  workspaceId     String
  socialAccountId String
  proxyEndpointId String
  isActive        Boolean   @default(true)
  assignedAt      DateTime  @default(now())
  releasedAt      DateTime?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  proxyEndpoint ProxyEndpoint @relation(fields: [proxyEndpointId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, isActive])
  @@index([proxyEndpointId, isActive])
}

model IpRotationLog {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  proxyEndpointId String?
  oldIp           String?
  newIp           String?
  reason          String
  success         Boolean  @default(true)
  createdAt       DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  proxyEndpoint ProxyEndpoint? @relation(fields: [proxyEndpointId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model SessionHealthCheck {
  id              String   @id @default(cuid())
  workspaceId     String
  socialAccountId String
  ok              Boolean
  latencyMs       Int?
  signal          String?
  details         String?
  createdAt       DateTime @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([socialAccountId, createdAt(sort: Desc)])
}

enum CampaignMode {
  draft
  approval_required
  auto
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  failed
}

enum ListenerType {
  keyword
  competitor
  trend
}

enum TargetPostStatus {
  new
  generating
  drafted
  approved
  sent
  skipped
  failed
}

enum DraftStatus {
  pending
  approved
  rejected
  sent
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  tone         String   @default("professional")
  language     String   @default("id")
  systemPrompt String   @db.Text
  status       String   @default("active")
  // Optional model routing override (workspace provider + model id)
  aiProviderId String?
  model        String?
  temperature  Float?
  maxTokens    Int?
  // Personality / characteristics pack for comment bots
  style        String   @default("balanced") // concise | balanced | detailed | expert
  formality    String   @default("neutral") // casual | neutral | formal
  emojiPolicy  String   @default("light") // none | light | ok
  ctaStyle     String   @default("soft") // none | soft | direct
  maxSentences Int      @default(3)
  bannedTopics String[] @default([])
  mustInclude  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiProvider         WorkspaceAiProvider? @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  campaigns          Campaign[]
  drafts             CommentDraft[]
  contentCampaigns   ContentCampaign[]
  contentDrafts      ContentDraft[]
  guardrails         AgentGuardrail[]
  knowledgeDocuments KnowledgeDocument[]
  memoryEntries      MemoryEntry[]
  skillRuns          SkillRun[]
  riskRules          RiskRule[]
  autoReplySettings  AutoReplySettings[]

  @@index([workspaceId, status])
  @@index([aiProviderId])
}

enum AiProviderKind {
  ninerouter
  openai
  anthropic
  openai_compatible
}

/// Komenin AI subscription tier. `none` = BYOK only / free.
enum AiTier {
  none
  starter
  pro
  pro_max
}

enum AiSubscriptionStatus {
  active
  past_due
  canceled
  expired
}

enum AiLedgerKind {
  grant
  reservation
  reservation_release
  subscription_use
  payg_use
  refund
  expire
}

enum AiBillingSource {
  own_key
  subscription
  payg
}

model WorkspaceAiSubscription {
  id                    String               @id @default(cuid())
  workspaceId           String               @unique
  tier                  AiTier               @default(none)
  /// Included credits per quota month (1 credit = 1 token).
  monthlyCredits        BigInt               @default(0)
  status                AiSubscriptionStatus @default(active)
  /// Commitment / paid entitlement window (1 or 12 months).
  termStart             DateTime
  termEnd               DateTime
  /// Independently advancing monthly quota window, even for annual plans.
  quotaPeriodStart      DateTime
  quotaPeriodEnd        DateTime
  /// Tier changes apply only when quotaPeriodEnd is reached (no proration v1).
  pendingTier           AiTier?
  pendingMonthlyCredits BigInt?
  pendingPlanCode       String?
  sourceOrderId         String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([quotaPeriodEnd])
  @@index([termEnd])
}

/// Append-only credit ledger. Positive `credits` = grant/release, negative =
/// usage/reservation/refund/expiry. `operationId` makes each financial effect
/// idempotent and links reservation → settlement → usage.
model AiCreditLedger {
  id            String           @id @default(cuid())
  workspaceId   String
  operationId   String           @unique
  kind          AiLedgerKind
  credits       BigInt
  balanceAfter  BigInt?
  /// Funding bucket for reservation/usage rows (subscription quota vs PAYG
  /// balance). NULL on grant/refund/expire rows (PAYG-only) and legacy rows.
  /// Without this, a reservation against one bucket would incorrectly reduce
  /// the OTHER bucket's computed balance (double-count on Pro Max fallback).
  source        AiBillingSource?
  refType       String?
  refId         String?
  sourceOrderId String?
  usageEventId  String?          @unique
  /// Set only on grants; expiry is materialized as an explicit `expire` row.
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  usageEvent AiUsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([sourceOrderId])
}

/// Cached running AI credit balance per workspace — a projection of the
/// append-only ledger, maintained in the same transaction as each ledger
/// write. Reads hit this row instead of SUM()-scanning the whole ledger.
/// The ledger remains the source of truth; this is a rebuildable cache.
model WorkspaceAiBalance {
  workspaceId      String    @id
  /// PAYG prepaid balance (grants - payg_use - refund - expire ± reservations).
  paygCredits      BigInt    @default(0)
  /// Credits consumed from the subscription quota in the current quota period.
  subscriptionUsed BigInt    @default(0)
  /// Quota period this subscriptionUsed counter belongs to.
  quotaPeriodStart DateTime?
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

/// Satu baris per AI call (BYOK tercatat dengan creditsUsed=0 untuk analitik).
model AiUsageEvent {
  id           String          @id @default(cuid())
  workspaceId  String
  requestId    String          @unique
  /// ID provider workspace (BYOK) atau "komenin:<model>".
  providerId   String?
  model        String
  inputTokens  Int
  outputTokens Int
  creditsUsed  BigInt          @default(0)
  billedTo     AiBillingSource
  usageSource  String          @default("reported")
  latencyMs    Int?
  refType      String?
  refId        String?
  createdAt    DateTime        @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ledgerEntry AiCreditLedger?

  @@index([workspaceId, createdAt])
}

model WorkspaceAiProvider {
  id          String         @id @default(cuid())
  workspaceId String
  kind        AiProviderKind
  label       String
  baseUrl     String?
  apiKeyEnc   String?        @db.Text
  models      String[]
  isEnabled   Boolean        @default(true)
  priority    Int            @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@index([workspaceId, isEnabled, priority])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  platform    Platform
  mode        CampaignMode   @default(approval_required)
  status      CampaignStatus @default(draft)
  agentId     String?
  clientId    String?
  dailyLimit  Int            @default(30)
  minDelaySec Int            @default(45)
  maxDelaySec Int            @default(180)
  goal        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  client      ClientProfile?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accounts    CampaignAccount[]
  listeners   Listener[]
  targetPosts TargetPost[]
  drafts      CommentDraft[]
  actions     CommentAction[]
  approvals   Approval[]
  leads       EngagementLead[]

  @@index([workspaceId, status])
  @@index([clientId])
}

model CampaignAccount {
  id              String @id @default(cuid())
  campaignId      String
  socialAccountId String

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, socialAccountId])
}

model Listener {
  id                  String       @id @default(cuid())
  workspaceId         String
  campaignId          String?
  platform            Platform
  type                ListenerType
  query               String
  isActive            Boolean      @default(true)
  /// Auto-poll cadence in minutes; null = manual polling only. Consumed by the
  /// `listener.autopoll` worker job (dedicated cron, not worker.tick).
  pollIntervalMinutes Int?
  /// Last time this listener was polled (manual poll, tick poll, or autopoll).
  lastPolledAt        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  posts     TargetPost[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, isActive, lastPolledAt])
}

model TargetPost {
  id           String           @id @default(cuid())
  workspaceId  String
  campaignId   String?
  listenerId   String?
  platform     Platform
  externalId   String
  authorHandle String
  content      String           @db.Text
  url          String?
  status       TargetPostStatus @default(new)
  /// Operator owner (User.id) for daily triage; nullable + SetNull on delete.
  assigneeId   String?
  discoveredAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  listener  Listener?        @relation(fields: [listenerId], references: [id], onDelete: SetNull)
  assignee  User?            @relation("TargetPostAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  drafts    CommentDraft[]
  actions   CommentAction[]
  approvals Approval[]
  leads     EngagementLead[]

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, status, discoveredAt(sort: Desc)])
  @@index([assigneeId])
}

model CommentDraft {
  id           String      @id @default(cuid())
  workspaceId  String
  campaignId   String?
  targetPostId String
  agentId      String?
  content      String      @db.Text
  status       DraftStatus @default(pending)
  providerId   String?
  model        String?
  riskFlags    String[]
  mentionId    String?
  /// A/B copy variant label (e.g. "A", "B"). Null = control / unassigned.
  variant      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetPost TargetPost     @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  agent      Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  mention    Mention?       @relation("MentionDrafts", fields: [mentionId], references: [id], onDelete: SetNull)
  approval   Approval?
  action     CommentAction?

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([mentionId, createdAt(sort: Desc)])
}

model Approval {
