}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  hashedKey   String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model CustomRole {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Agency multi-client tag — lightweight isolation label inside one workspace.
model ClientProfile {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     EngagementLead[]
  campaigns Campaign[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

/// Lead captured from social engagement (comment/inbox/approval).
model EngagementLead {
  id           String     @id @default(cuid())
  workspaceId  String
  clientId     String?
  targetPostId String?
  campaignId   String?
  platform     Platform?
  handle       String
  displayName  String?
  contactEmail String?
  contactPhone String?
  source       LeadSource @default(manual)
  status       LeadStatus @default(new)
  intent       String?
  notes        String?    @db.Text
  postSnippet  String?    @db.Text
  draftSnippet String?    @db.Text
  externalUrl  String?
  /**
   * Optional operator owner (User.id) for follow-up accountability.
   */
  ownerUserId  String?
  /**
   * Next follow-up due date (workspace-local intent; stored UTC).
   */
  followUpAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  targetPost TargetPost?    @relation(fields: [targetPostId], references: [id], onDelete: SetNull)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, handle])
  @@index([clientId])
  @@index([workspaceId, followUpAt])
  @@index([ownerUserId])
}

/// In-app support ticket opened by a workspace user (platform-level queue).
model SupportTicket {
  id            String                @id @default(cuid())
  subject       String
  category      SupportTicketCategory
  priority      SupportTicketPriority @default(normal)
  status        SupportTicketStatus   @default(open)
  reporterId    String
  reporterEmail String
  reporterName  String?
  workspaceId   String?
  workspaceName String?
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  reporter  User                   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  workspace Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([workspaceId])
}

/// One message in a support ticket conversation (reporter, CS, or system).
model SupportTicketMessage {
  id         String                  @id @default(cuid())
  ticketId   String
  authorRole SupportTicketAuthorRole
  authorId   String?
  authorName String?
  body       String                  @db.Text
  createdAt  DateTime                @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum SupportTicketCategory {
  bug
  billing
  account
  feature
  other
}

enum SupportTicketPriority {
  low
  normal
  high
}

enum SupportTicketAuthorRole {
  reporter
  cs
  system
}

// Idempotency outcomes for the connector bridge server (dev/test tooling).
// Persisted so a bridge restart cannot turn a redelivery into a duplicate
// post — the in-memory Map in bridge-server.ts is only a hot cache.
model BridgeIdempotencyKey {
  key       String   @id
  status    Int
  body      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
